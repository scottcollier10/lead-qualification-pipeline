# LQ v2 deploy build settings. No secrets belong in this file.
# Tokens and keys live only inside n8n credentials.
#
# Copy to .env.lq-v2.local (already gitignored by the .env.*.local rule), fill in,
# then build deployable exports:
#   node scripts/build-workflows.js --env-file .env.lq-v2.local --out dist
# The build refuses placeholders, the v1 database URL and malformed channel IDs.

# Dedicated v2 Supabase project. Must NOT be the v1 Lead Intake project (ivzmpbtbxvbepzstcmjf).
# Format: https://<project-ref>.supabase.co with no trailing slash.
LQ_V2_SUPABASE_URL=https://your-new-project-ref.supabase.co

# Dedicated Slack channel for v2 lead notifications (channel ID, not name).
LQ_V2_SLACK_CHANNEL_ID=C0XXXXXXXXX

# Optional: channel for workflow error alerts. Defaults to LQ_V2_SLACK_CHANNEL_ID.
LQ_V2_SLACK_OPS_CHANNEL_ID=

# n8n credential IDs and names. n8n 2.14.x import binds credentials only by
# exact ID, so create these three credentials first, then copy their IDs here.
#   Supabase: type "Multiple Headers Auth" (httpMultipleHeadersAuth) with the
#             header apikey = the project's secret key (sb_secret_...). Add NO Authorization
#             header: Supabase passes it to PostgREST, which rejects a non-JWT value with
#             401 PGRST301 "Expected 3 parts in JWT". (Only a legacy service_role JWT may
#             also go in Authorization: Bearer.)
#   Slack:    type "Header Auth" (httpHeaderAuth), Authorization: Bearer xoxb-...
#   Webhook:  type "Header Auth" (httpHeaderAuth), X-LQ-Webhook-Token: <long random value>
LQ_V2_CRED_SUPABASE_ID=
LQ_V2_CRED_SUPABASE_NAME=LQ v2 Supabase Service Role
LQ_V2_CRED_SLACK_ID=
LQ_V2_CRED_SLACK_NAME=LQ v2 Slack Bot
LQ_V2_CRED_WEBHOOK_ID=
LQ_V2_CRED_WEBHOOK_NAME=LQ v2 Intake Webhook Token

# ID of the imported "LQ v2 - Error Handler" workflow. Leave empty on the first
# build, import the error handler, fill this in, rebuild, then import the other two.
LQ_V2_ERROR_WORKFLOW_ID=

# Migrations use a database URL from your shell only, never from this file:
#   export LQ_V2_DATABASE_URL='postgresql://...'   (Supabase session pooler string)
